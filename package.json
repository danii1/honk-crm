    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.91.0",
