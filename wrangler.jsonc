{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outreach-crm",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/dashboard", "/dashboard/*", "/v1/*", "/api/*", "/mcp", "/.well-known/*", "/sign-in", "/consent", "/accept-invite", "/invites/*"]
  },
  "vars": { "BETTER_AUTH_URL": "https://outreach-crm.daniil-pokrovsky.workers.dev" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "outreach-crm",
      "database_id": "1645f13f-75bd-48af-99ae-422bc726a043",
      "migrations_dir": "migrations"
    }
  ]
}
